@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://github.com/tylorismusic-commits/comp-suite>
    a lv2:Plugin ;
    lv2:binary <comp_suite.so> ;
    rdfs:seeAlso <comp_suite.ttl> ;
    ui:ui <https://github.com/tylorismusic-commits/comp-suite#ui> .

<https://github.com/tylorismusic-commits/comp-suite#ui>
    a ui:X11UI ;
    ui:binary <comp_suite_ui.so> ;
    lv2:requiredFeature ui:parent ;
    rdfs:seeAlso <comp_suite.ttl> .
